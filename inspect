#!/bin/sh
# Runs the inspector from this folder; the first run sets up its Python environment (numpy and scipy) in .venv.
dir=$(cd "$(dirname "$0")" && pwd)
if [ ! -x "$dir/.venv/bin/python" ]; then
    python3 -m venv "$dir/.venv" && "$dir/.venv/bin/pip" install -q -r "$dir/requirements.txt" || exit 2
fi
PYTHONPATH="$dir${PYTHONPATH:+:$PYTHONPATH}" exec "$dir/.venv/bin/python" -m support_inspector "$@"
